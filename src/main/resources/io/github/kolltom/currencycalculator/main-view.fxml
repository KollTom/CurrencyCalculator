<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.kolltom.currencycalculator.AppController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <ComboBox fx:id="currencyBox"/>
    <ComboBox fx:id="targetCurrencyBox"/>
    <TextField fx:id="moneyField" promptText="Enter amount"/>


    <Label fx:id="resultLabel"/>
    <Button text="Calculate" onAction="#onCalculateButtonClick"/>
</VBox>
